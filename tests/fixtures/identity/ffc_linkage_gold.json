        "display_name": "DeAndre Halloway",
        "position": "WR",
        "team": "CIN",
        "order_key": 4.1
      },
      "expect": {
        "outcome": "accepted",
        "player_id": "gsis:00-0000001",
        "method": "resolved_exact_name_position"
      }
    },
    {
