# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local data / caches. Raw vendor data is re-fetched, never committed
# (see AGENTS.md section 15 and docs/OPERATIONS.md section 4).
data/cache/
data/raw/
*.parquet
*.csv.gz
# The historical modelling dataset. Reproducible from code plus source releases with
# `ffdraft build-historical`, so it stays out of source commits; the committed record of
# what it contains is docs/FEATURE_DICTIONARY.md plus the SESSION_STATE.md build summary.
data/historical/
# Phase-4 development intermediates: out-of-fold predictions from the promoted
# architecture, simulated VORP draws and tier working sets. All reproducible from the
# `ffdraft evaluate-*` commands; the committed record is the experiment reports under
# docs/experiments/.
data/phase4/
# The Phase-11 rest-of-season snapshot dataset and its development intermediates.
# Reproducible from code plus source releases with `ffdraft build-ros-dataset`; the
# committed record is docs/experiments/phase11-ros/ plus the ROS feature dictionary in
# docs/MODELING.md.
data/ros/

# Node
node_modules/
web/dist/
# The end-to-end run builds the project-Pages site and the degraded-artifact scenarios
# beside it, and `verify:board` builds one from the real generated artifacts.
web/dist-*/
web/test-results/
playwright-report/
# Generated public artifacts. Reproducible from `ffdraft build-fixture-artifacts` or the
# daily refresh, so they stay out of source commits (AGENTS.md section 15). The committed
# fixture artifacts under tests/fixtures/artifacts/ are a different thing and are tracked.
web/public/data/
*.tsbuildinfo

# A local checkout of the append-only capture store (ADR-038). It is a separate long-lived
# branch that shares no history with `main`, so a checkout of it must never be committed
# into a code branch. Clone it beside the repository, or here under this name.
/market-data/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
