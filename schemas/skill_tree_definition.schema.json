{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/skill_tree_definition.schema.json",
  "title": "SkillTreeDefinition",
  "description": "What one Skill Tree metric is at one position under `skill_tree_v1` (ADR-107): where it sits in the tree, what it counts, from which source fields, against whom it is ranked, how to read it and what it cannot say. Every word the card prints about a metric comes from these records. One record per position × metric, including the `appearances` presence metric and the `combine_forty` archive plaque.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "build_id", "season", "through_week", "method_version", "position",
    "metric_id", "role", "branch_id", "branch_label", "branch_order", "order",
    "parent_metric_id", "label", "short_label", "kind", "direction", "unit", "decimals",
    "source_id", "source_label", "source_fields", "formula", "numerator_label",
    "denominator_label", "minimum", "minimum_unit", "cohort_rule", "definition",
    "interpretation", "limitations", "window", "source_status", "source_reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "build_id": {"type": "string", "minLength": 1},
    "season": {"type": "integer", "minimum": 2000},
    "through_week": {"type": "integer", "minimum": 1},
    "method_version": {"const": "skill_tree_v1"},
    "position": {"enum": ["QB", "RB", "WR", "TE"]},
    "metric_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "role": {
      "enum": ["presence", "node", "detail", "archive"],
      "description": "node: drawn in the tree. detail: shown when its parent node is selected. presence: games played (the tree's header). archive: the dated combine plaque."
    },
    "branch_id": {"type": ["string", "null"]},
    "branch_label": {"type": ["string", "null"]},
    "branch_order": {"type": ["integer", "null"], "minimum": 1},
    "order": {"type": "integer", "minimum": 0, "description": "Position within the branch (nodes) or within the parent's details."},
    "parent_metric_id": {"type": ["string", "null"]},
    "label": {"type": "string", "minLength": 1},
    "short_label": {"type": "string", "minLength": 1, "maxLength": 16},
    "kind": {"enum": ["volume", "share", "rate", "context"]},
    "direction": {"enum": ["higher", "lower", "neutral"]},
    "unit": {"enum": ["count", "fraction", "pp", "yards", "epa", "seconds"]},
    "decimals": {"type": "integer", "minimum": 0, "maximum": 4},
    "source_id": {"enum": ["player_stats", "snap_counts", "play_by_play", "next_gen_stats", "combine"]},
    "source_label": {"type": "string", "minLength": 1},
    "source_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "formula": {"type": "string", "minLength": 1},
    "numerator_label": {"type": ["string", "null"]},
    "denominator_label": {"type": ["string", "null"]},
    "minimum": {"type": ["number", "null"], "minimum": 0},
    "minimum_unit": {"type": ["string", "null"]},
    "cohort_rule": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1},
    "window": {"type": "string", "minLength": 1},
    "source_status": {"enum": ["published", "unavailable"]},
    "source_reason": {"type": ["string", "null"]}
  }
}
