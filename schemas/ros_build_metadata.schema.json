{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ros_build_metadata.schema.json",
  "title": "RosBuildMetadata",
  "description": "Build-level provenance for the in-season bundle. Separate from build_metadata.json on purpose: the draft board and the rest-of-season board are produced by different models on different cadences from different cutoffs, so they carry different build ids and are validated independently (roadmap 12.5). A directory may hold either bundle, both, or one refreshed while the other is not.",
  "$defs": {
    "skill_tree_source": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["published", "unavailable"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "build_id", "generated_at_utc", "git_sha", "season",
    "through_week", "season_state", "ros_model_version", "cutoff_rule_version",
    "methodology_version", "simulation", "source_freshness", "disclosures",
    "limitations", "supported_presets", "sources", "quality_gate", "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "build_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "git_sha": {"type": "string", "minLength": 7},
    "season": {"type": "integer", "minimum": 2000},
    "through_week": {
      "type": "integer",
      "minimum": 1,
      "description": "The point-in-time cutoff every number in this bundle was computed at."
    },
    "season_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rule_version", "season_state", "product_mode", "completed_week"],
      "properties": {
        "rule_version": {"type": "string", "minLength": 1},
        "season_state": {
          "enum": ["preseason_draft", "regular_season", "fantasy_postseason", "season_complete"]
        },
        "product_mode": {"enum": ["draft", "in_season"]},
        "completed_week": {"type": "integer", "minimum": 0},
        "latest_snapshot_week": {"type": ["integer", "null"], "minimum": 1},
        "next_transition_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "ros_model_version": {"type": "string", "minLength": 1},
    "ros_model_configuration_hash": {
      "type": ["string", "null"],
      "description": "Digest of the frozen architecture the fit used (ADR-078). Two fits of the accepted model on different training windows agree here; a tuned parameter does not."
    },
    "production_fit_rule_version": {"type": ["string", "null"]},
    "model_fitted_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "model_training_seasons": {"type": "array", "items": {"type": "integer"}},
    "model_refit_reason": {"type": ["string", "null"]},
    "cutoff_rule_version": {"type": "string", "minLength": 1},
    "feature_set_version": {"type": ["string", "null"]},
    "feature_set_hash": {"type": ["string", "null"]},
    "methodology_version": {"type": "string", "minLength": 1},
    "simulation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["draws", "seed", "replacement_rule", "convergence_gate", "tier_stability_gate"],
      "properties": {
        "draws": {"type": "integer", "minimum": 1},
        "draws_status": {"type": "string"},
        "seed": {"type": "integer"},
        "ranking_statistic": {"type": "string"},
        "replacement_rule": {"enum": ["fresh_allocation", "rostered_depth"]},
        "replacement_rule_description": {"type": "string"},
        "tier_algorithm": {"type": "string"},
        "tier_penalty": {"type": "number"},
        "tier_depth": {"type": "integer", "minimum": 1},
        "value_version": {"type": "string"},
        "convergence_gate": {"enum": ["pass", "fail"]},
        "tier_stability_gate": {"enum": ["pass", "fail"]}
      }
    },
    "source_freshness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rule_version", "available_through_week", "schedule_completed_week"],
      "properties": {
        "rule_version": {"type": "string"},
        "available_through_week": {"type": "integer", "minimum": 0},
        "schedule_completed_week": {"type": "integer", "minimum": 0},
        "blocking_week": {"type": ["integer", "null"]},
        "buildable": {"type": "boolean"}
      }
    },
    "behavior": {
      "type": ["object", "null"],
      "description": "The optional in-season behaviour feed powering the Opportunity Board. Null or unavailable degrades that board's behaviour columns and nothing else.",
      "additionalProperties": true,
      "properties": {
        "source_id": {"type": ["string", "null"]},
        "available": {"type": "boolean"},
        "snapshot_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "lookback_hours": {"type": ["integer", "null"]},
        "request_limit": {"type": ["integer", "null"]},
        "add_rows": {"type": ["integer", "null"], "minimum": 0},
        "drop_rows": {"type": ["integer", "null"], "minimum": 0},
        "matched_players": {"type": ["integer", "null"], "minimum": 0},
        "age_hours": {"type": ["number", "null"], "minimum": 0},
        "degraded_reason": {"type": ["string", "null"]},
        "coverage_rule": {
          "type": "string",
          "description": "ADR-114: `sleeper_top_n_v1` - each feed is a descending top-N list capped at feed_ceiling rows, so a player absent from a retrieved feed has an unknown count no greater than its floor, never a zero."
        },
        "feed_ceiling": {"type": "integer", "minimum": 1, "description": "The most rows a trending feed returns whatever limit is requested: 100, measured 2026-10-21."},
        "add_available": {"type": "boolean", "description": "Whether the add feed was retrieved in the capture behind the board. Tracked independently of the drop feed."},
        "drop_available": {"type": "boolean"},
        "add_feed_floor": {"type": ["integer", "null"], "minimum": 0, "description": "The smallest count in the add feed: the upper bound on a player absent from it."},
        "drop_feed_floor": {"type": ["integer", "null"], "minimum": 0},
        "add_retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "drop_retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "coverage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Coverage of this board's own players, per side: how many distinct published players each feed observed, missed, or could not reach, and how many carry an exact net. Different from raw-feed completeness, which is capped at feed_ceiling.",
          "properties": {
            "players": {"type": "integer", "minimum": 0},
            "add_states": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "drop_states": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "net_exact": {"type": "integer", "minimum": 0}
          }
        },
        "signal_semantics": {"type": "string"},
        "history": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "The retained window behind `behavior_trend_series.json` (ADR-089). Null when no retained observation falls inside the trend window, which withholds the momentum sparkline and nothing else. `snapshot_at_utc` above is the single instant the board's own counts came from; this describes every instant the series draws.",
          "properties": {
            "rule_version": {"type": "string", "description": "`behavior_trend_v2` (ADR-114); `behavior_trend_v1` before it."},
            "window_days": {"type": "number", "exclusiveMinimum": 0},
            "min_observations": {
              "type": "integer",
              "minimum": 2,
              "description": "Observations required before a direction is stated. Two: a line needs two points, and an add count moves far too fast for the market rule's three-day bar."
            },
            "snapshots_in_window": {"type": "integer", "minimum": 0},
            "snapshot_keys": {"type": "array", "items": {"type": "string"}},
            "anchored_at_utc": {"type": ["string", "null"], "format": "date-time"},
            "observations": {"type": "integer", "minimum": 0},
            "players": {"type": "integer", "minimum": 0},
            "players_with_trend": {"type": "integer", "minimum": 0},
            "players_with_sparse_coverage": {
              "type": "integer",
              "minimum": 0,
              "description": "Players the window held snapshots for that did not carry them — days they were outside the feed's top N, which is an unknown count rather than a zero."
            },
            "players_with_net_trend": {"type": "integer", "minimum": 0, "description": "behavior_trend_v2: players with a net slope, which needs two points with both sides observed."},
            "players_with_one_sided_points": {"type": "integer", "minimum": 0, "description": "Players with at least one point carrying only one side (in one feed's top 100 and not the other's)."},
            "trend_available": {"type": "boolean"},
            "unresolved_rows": {"type": "integer", "minimum": 0},
            "lookback_hours": {"type": ["integer", "null"]},
            "request_limit": {"type": ["integer", "null"]},
            "source_id": {"type": ["string", "null"]}
          }
        }
      }
    },
    "surface": {
      "type": ["object", "null"],
      "description": "The public surface universe for the in-season board (ADR-063): who is visible and why.",
      "additionalProperties": true
    },
    "signals": {
      "type": ["object", "null"],
      "description": "The in-season signal layer (ADR-091): which rules produced player_usage.json and team_matchups.json, how many records each carries, and the two sentences that must travel with them. Optional and additive: absent or null removes the evidence blocks those artifacts feed and nothing else.",
      "additionalProperties": false,
      "required": [
        "usage_rule", "usage_records", "matchup_rule_version", "matchup_records",
        "lines_source_id", "lines_retrieved_at_utc", "lines_posted_teams",
        "sportsbook_context_statement", "expected_points_statement"
      ],
      "properties": {
        "usage_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version", "change_rule_version", "min_earlier_games",
            "min_touchdown_share_points", "min_epa_dropbacks"
          ],
          "properties": {
            "version": {"const": "usage_signals_v1"},
            "change_rule_version": {"const": "role_change_v1"},
            "min_earlier_games": {"type": "integer", "minimum": 1},
            "min_touchdown_share_points": {"type": "number", "minimum": 0},
            "min_epa_dropbacks": {"type": "number", "minimum": 0}
          }
        },
        "usage_records": {"type": "integer", "minimum": 0},
        "matchup_rule_version": {"const": "next_game_v1"},
        "matchup_records": {"type": "integer", "minimum": 0},
        "lines_source_id": {"type": ["string", "null"]},
        "lines_retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "lines_posted_teams": {
          "type": "integer",
          "minimum": 0,
          "description": "Teams whose next game carries a posted spread and total."
        },
        "sportsbook_context_statement": {
          "type": "string",
          "minLength": 1,
          "description": "Printed wherever a line is shown: which models read the lines (since ADR-096, the weekly start/sit projection only) and which never do (every draft and rest-of-season number)."
        },
        "expected_points_statement": {
          "type": "string",
          "minLength": 1,
          "description": "Why no expected-points reading is published (the open CC-BY-SA decision, ADR-086)."
        },
        "drive_breadth": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "required": ["method_version", "status", "statement"],
          "description": "ADR-103/ADR-104: whether the drive-breadth blocks on player_usage were published, the window and provisional display minimums, each position's displayed quartiles on this build (no longer printed on the card), and the statement the Data view prints. Optional and additive.",
          "properties": {
            "method_version": {"const": "drive_breadth_v2"},
            "status": {"enum": ["published", "unavailable"]},
            "statement": {"type": "string", "minLength": 1},
            "position_reference": {"type": ["object", "null"]}
          }
        }
      }
    },
    "weekly": {
      "type": ["object", "null"],
      "description": "The weekly start/sit layer (ADR-096): which model produced weekly_projections.json, for which week, how a page turns seven quantiles into a distribution, and the measured numbers the Start/Sit tab prints beside it — matchup-margin uncertainty, same-game correlation, league startable thresholds, injury-designation appearance rates and the sealed-season evaluation. Optional and additive: absent or null removes the Start/Sit tab's content and nothing else.",
      "additionalProperties": false,
      "required": [
        "model_version", "candidate_version", "configuration_hash", "training_seasons",
        "fitted_at_utc", "through_week", "target_week", "records", "upcoming", "kicked_off",
        "bye", "lines_pending", "quantile_levels", "distribution_rule", "families", "margin", "correlation",
        "startable", "injury_base_rates", "evaluation", "injuries_retrieved_at_utc", "statement"
      ],
      "properties": {
        "model_version": {"const": "weekly-startsit-v1"},
        "candidate_version": {"type": "string", "minLength": 1},
        "configuration_hash": {"type": "string", "minLength": 8},
        "training_seasons": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
        "fitted_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "through_week": {"type": "integer", "minimum": 1},
        "target_week": {"type": "integer", "minimum": 2},
        "records": {"type": "integer", "minimum": 0},
        "upcoming": {"type": "integer", "minimum": 0},
        "kicked_off": {"type": "integer", "minimum": 0},
        "bye": {"type": "integer", "minimum": 0},
        "lines_pending": {"type": "integer", "minimum": 0, "description": "Players whose game has no posted total or spread yet: published without a distribution."},
        "quantile_levels": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "minItems": 3},
        "distribution_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "tail_lower_factor", "tail_upper_factor", "grid_points"],
          "properties": {
            "version": {"const": "quantile_distribution_v1"},
            "tail_lower_factor": {"type": "number", "minimum": 0},
            "tail_upper_factor": {"type": "number", "minimum": 0},
            "grid_points": {"type": "integer", "minimum": 10}
          }
        },
        "families": {"type": "object", "additionalProperties": {"type": "string"}},
        "margin": {"type": "object", "description": "Per scoring preset: residual variance by position among starters, the lineup total, and margin_sd_by_slot — the standard deviation of a matchup's margin from every other slot. Out-of-fold."},
        "correlation": {"type": "object", "description": "Same-game Gaussian-copula correlations, teammates by position pair and opponents, from out-of-fold PIT values."},
        "startable": {"type": "object", "description": "Per league preset and scoring preset: the average points of the last starter at each position."},
        "injury_base_rates": {"type": "object", "description": "Per official designation: reports, appearances and the appearance rate over the training seasons."},
        "evaluation": {"type": "object", "description": "The sealed-season (2025) result the page quotes, including the start/sit calibration table."},
        "injuries_retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "statement": {"type": "string", "minLength": 40},
        "explanation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["rule", "levels", "groups", "reference_shrink_games", "reference", "statement"],
          "description": "How every weekly record's `explanation` was made (ADR-099): the typical-week reference, the explained levels, the input groups and their labels, and the sentence that keeps an attribution from reading as a causal effect.",
          "properties": {
            "rule": {"const": "typical_week_shapley_v1"},
            "levels": {"type": "array", "items": {"enum": ["q10", "q50", "q90"]}, "minItems": 1},
            "groups": {"type": "object", "additionalProperties": {"type": "string"}},
            "reference_shrink_games": {"type": "number", "minimum": 0},
            "reference": {"type": "string", "minLength": 40},
            "statement": {"type": "string", "minLength": 40}
          }
        },
        "context": {
          "type": ["object", "null"],
          "description": "What weekly_context.json was built from (ADR-099): forecast capture key and time, weather statuses by count, report rows and teams whose report carries game statuses, listed players, unresolved venues. Null when the context was withheld."
        },
        "shadow": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["model_version", "status", "rows"],
          "description": "The private weekly-startsit-v2 shadow record's summary (ADR-099): whether a shadow candidate ran beside v1 and how many pregame rows it retained. The rows themselves are never published.",
          "properties": {
            "model_version": {"const": "weekly-startsit-v2"},
            "status": {"enum": ["absent", "shadow", "failed"]},
            "rows": {"type": "integer", "minimum": 0},
            "pregame": {"type": "integer", "minimum": 0},
            "with_v2": {"type": "integer", "minimum": 0},
            "configuration_hash": {"type": ["string", "null"]}
          }
        }
      }
    },
    "skill_tree": {
      "type": ["object", "null"],
      "description": "ADR-107: how player_skill_tree.json and skill_tree_definitions.json were built — the rule, the cutoff window, the population at each position, each source's status (a withheld or failed source makes its readings `unavailable`, never ranked over a smaller league), the minimum cohort for a rank, whether Next Gen Stats readings are published, diagnostics, and the sentence for every `reason` code a reading can carry. `failed` means the enrichment itself could not run and neither artifact was published. Optional and additive: absent or null means the card has no Skill Tree.",
      "additionalProperties": false,
      "required": ["method_version", "status"],
      "properties": {
        "method_version": {"const": "skill_tree_v1"},
        "status": {"enum": ["published", "failed"]},
        "reason": {"type": ["string", "null"]},
        "season": {"type": "integer", "minimum": 2000},
        "through_week": {"type": "integer", "minimum": 1},
        "window": {"type": "string", "minLength": 1},
        "records": {"type": "integer", "minimum": 0},
        "players": {"type": "integer", "minimum": 0},
        "players_without_appearance": {"type": "integer", "minimum": 0},
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["QB", "RB", "WR", "TE"],
          "properties": {
            "QB": {"type": "integer", "minimum": 0},
            "RB": {"type": "integer", "minimum": 0},
            "WR": {"type": "integer", "minimum": 0},
            "TE": {"type": "integer", "minimum": 0}
          }
        },
        "minimum_cohort": {"type": "integer", "minimum": 2},
        "ngs_published": {"type": "boolean"},
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["player_stats", "snap_counts", "play_by_play", "next_gen_stats", "combine"],
          "properties": {
            "player_stats": {"$ref": "#/$defs/skill_tree_source"},
            "snap_counts": {"$ref": "#/$defs/skill_tree_source"},
            "play_by_play": {"$ref": "#/$defs/skill_tree_source"},
            "next_gen_stats": {"$ref": "#/$defs/skill_tree_source"},
            "combine": {"$ref": "#/$defs/skill_tree_source"}
          }
        },
        "diagnostics": {"type": "object"},
        "reasons": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "espn_ownership": {
      "type": ["object", "null"],
      "description": "ADR-112: how espn_ownership.json and espn_ownership_series.json were built — ESPN's public roster and start percentages under espn_ownership_v1, read from the private retained store. `published`: both artifacts were written (the series only for players with a retained point). `unavailable`: no retained capture fell inside the window, so neither was. `failed`: the enrichment raised and neither was. Optional and additive: absent or null (an older bundle) means the page shows no ESPN reading and disables the ESPN filter, saying why. Never a model input.",
      "additionalProperties": false,
      "required": ["rule_version", "status", "source_id"],
      "properties": {
        "rule_version": {"const": "espn_ownership_v1"},
        "status": {"enum": ["published", "unavailable", "failed"]},
        "reason": {"type": ["string", "null"]},
        "source_id": {"const": "espn_fantasy_ownership"},
        "rule": {"type": "object", "description": "The frozen rule: windows, tolerances, the staleness bound, units, and the policies on start changes and absence."},
        "latest_snapshot_key": {"type": ["string", "null"]},
        "latest_observed_at_utc": {"type": ["string", "null"], "format": "date-time", "description": "Our retrieval instant of the newest retained capture."},
        "latest_age_hours": {"type": ["number", "null"], "minimum": 0, "description": "Hours between that retrieval and this build."},
        "stale": {"type": ["boolean", "null"], "description": "True when latest_age_hours exceeds the rule's staleness bound; every reading is then `stale` and passes no filter."},
        "espn_current_period": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
        "captures_in_window": {"type": "integer", "minimum": 0},
        "capture_times_utc": {"type": "array", "items": {"type": "string", "format": "date-time"}, "description": "Every retained capture inside the series window, oldest first. A day with no entry had no capture."},
        "skipped_captures": {"type": "integer", "minimum": 0, "description": "Retained captures in the window that failed their hash check and were left out."},
        "baseline_1d_observed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "baseline_7d_observed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "espn_universe_rows": {"type": "integer", "minimum": 0, "description": "QB/RB/WR/TE rows in the latest capture."},
        "espn_rows_matched": {"type": "integer", "minimum": 0, "description": "Of those, rows matched to a published player through the verified espn_id crosswalk."},
        "espn_rows_not_on_board": {"type": "integer", "minimum": 0, "description": "ESPN rows that reach no published player. ESPN never adds a player to the board."},
        "players": {"type": "integer", "minimum": 0},
        "series_players": {"type": "integer", "minimum": 0},
        "reading_states": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "start_states": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "change_states": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}},
        "attribution": {"type": "string", "minLength": 1},
        "population_statement": {"type": "string", "minLength": 1},
        "start_context_statement": {"type": "string", "minLength": 1}
      }
    },
    "recent_form": {"type": ["object", "null"], "description": "ADR-113: how recent_form.json was built — the window rule, the breakout rule's every threshold (so the page explains a badge from the artifact), the span and each window's real first and last week, the sentences the page prints, the population ranked in each window, and category counts. `withheld` (season actuals withheld, or no completed week) means no record was published and the page shows season columns only. Optional and additive: absent or null is the same unavailable state.", "additionalProperties": false, "required": ["rule", "breakout_rule", "status", "withheld_reason", "season", "through_week", "span_weeks", "windows", "scoring_presets", "definitions", "records", "population", "categories"], "properties": {"rule": {"type": "object", "additionalProperties": false, "required": ["version", "windows", "default_window", "points_decimals", "rank_method", "scoring_engine_version"], "properties": {"version": {"const": "recent_form_v1"}, "windows": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "default_window": {"type": "integer", "minimum": 1}, "points_decimals": {"type": "integer"}, "rank_method": {"const": "competition"}, "scoring_engine_version": {"type": "string"}}}, "breakout_rule": {"type": "object", "additionalProperties": false, "required": ["version", "bands", "min_gain_places", "min_gain_percent", "min_prior_games", "max_missed_after_latest", "takeover_games", "sneaking_games", "measures"], "properties": {"version": {"const": "breakout_v1"}, "bands": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "min_gain_places": {"type": "integer"}, "min_gain_percent": {"type": "integer"}, "min_prior_games": {"type": "integer"}, "max_missed_after_latest": {"type": "integer"}, "takeover_games": {"type": "integer"}, "sneaking_games": {"type": "integer"}, "measures": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["metric", "averaging", "substantial", "emerging", "increase"], "properties": {"metric": {"type": "string"}, "averaging": {"enum": ["pooled", "mean"]}, "substantial": {"type": "number"}, "emerging": {"type": ["number", "null"]}, "increase": {"type": ["number", "null"]}}}}}}}, "status": {"enum": ["published", "withheld"]}, "withheld_reason": {"type": ["string", "null"]}, "season": {"type": "integer", "minimum": 2000}, "through_week": {"type": "integer", "minimum": 1}, "span_weeks": {"type": "array", "items": {"type": "integer", "minimum": 1}, "maxItems": 6}, "windows": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["requested", "first_week", "last_week", "weeks"], "properties": {"requested": {"type": "integer"}, "first_week": {"type": ["integer", "null"]}, "last_week": {"type": ["integer", "null"]}, "weeks": {"type": "integer", "minimum": 0}}}}, "scoring_presets": {"type": "array", "items": {"enum": ["STD", "HALF", "PPR"]}}, "definitions": {"type": "object", "additionalProperties": {"type": "string"}}, "records": {"type": "integer", "minimum": 0}, "population": {"type": "object", "description": "window -> position -> players ranked (appeared in the window).", "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}, "categories": {"type": "object", "description": "preset -> window -> category -> records.", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}}},
    "insights": {"type": ["object", "null"], "description": "ADR-116: how insights.json was built — the story rules' every threshold, the lead-selection rule, each family's status (published, empty, unavailable) with its reason and its qualified, published and suppressed counts per preset, the state of every optional source a family depends on, the sentences the page prints, and the claims deliberately not made. `withheld` (a core input missing) means no story was published and the Insights tab says why. Optional and additive: absent or null is the same unavailable state.", "additionalProperties": false, "required": ["status", "withheld_reason", "rule_version", "selection_rule_version", "edition", "season", "through_week", "target_week", "generated_at_utc", "window", "rule", "selection", "families", "sources", "counts", "definitions", "limitations", "unsupported"], "properties": {"status": {"enum": ["published", "withheld"]}, "withheld_reason": {"type": ["string", "null"]}, "rule_version": {"const": "insights_v1"}, "selection_rule_version": {"const": "insights_select_v1"}, "edition": {"type": "string", "pattern": "^[0-9]{4}w[0-9]{2}$"}, "season": {"type": "integer", "minimum": 2000}, "through_week": {"type": "integer", "minimum": 1}, "target_week": {"type": ["integer", "null"], "minimum": 1}, "generated_at_utc": {"type": "string", "format": "date-time"}, "window": {"type": ["object", "null"], "additionalProperties": false, "required": ["first_week", "last_week", "weeks", "baseline_first_week", "baseline_last_week"], "properties": {"first_week": {"type": "integer", "minimum": 1}, "last_week": {"type": "integer", "minimum": 1}, "weeks": {"type": "integer", "minimum": 1}, "baseline_first_week": {"type": ["integer", "null"], "minimum": 1}, "baseline_last_week": {"type": ["integer", "null"], "minimum": 1}}}, "rule": {"type": "object", "description": "Every constant of `insights_v1` (`InsightRule.to_dict`), published whole so the page explains a story from the artifact."}, "selection": {"type": "object", "additionalProperties": false, "required": ["lead_max", "family_order", "family_caps", "team_cap", "one_story_per_player"], "properties": {"lead_max": {"type": "integer", "minimum": 1}, "family_order": {"type": "array", "items": {"type": "string"}}, "family_caps": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "team_cap": {"type": "integer", "minimum": 1}, "one_story_per_player": {"const": true}}}, "families": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "qualified", "published", "suppressed"], "properties": {"status": {"enum": ["published", "empty", "unavailable"]}, "reason": {"type": ["string", "null"]}, "qualified": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "published": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "suppressed": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}}, "sources": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["state", "detail"], "properties": {"state": {"enum": ["available", "partial", "unavailable"]}, "detail": {"type": ["string", "null"]}}}}, "counts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["stories", "lead"], "properties": {"stories": {"type": "integer", "minimum": 0}, "lead": {"type": "integer", "minimum": 0}}}}, "definitions": {"type": "object", "additionalProperties": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}, "unsupported": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "reason"], "properties": {"claim": {"type": "string"}, "reason": {"type": "string"}}}}}},
    "season_actuals": {
      "type": ["object", "null"],
      "description": "ADR-105: how season_actuals.json was built — the rule, the cutoff and the weeks it covers, the sentences every surface prints beside the numbers, the population ranked at each position, and the source coverage that decided whether it was published. `withheld` means a scheduled team-week was missing upstream and no actuals were published, so every surface prints them as unavailable rather than as ranks over a smaller population. Optional and additive: absent or null is the same unavailable state.",
      "additionalProperties": false,
      "required": [
        "rule", "status", "withheld_reason", "season", "through_week", "weeks", "horizon",
        "scoring_presets", "definitions", "records", "population", "coverage"
      ],
      "properties": {
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "points_decimals", "rank_method", "scoring_engine_version"],
          "properties": {
            "version": {"const": "season_actuals_v1"},
            "points_decimals": {"type": "integer", "minimum": 0},
            "rank_method": {"const": "competition"},
            "scoring_engine_version": {"type": "string", "minLength": 1}
          }
        },
        "status": {"enum": ["published", "withheld"]},
        "withheld_reason": {"type": ["string", "null"]},
        "season": {"type": "integer", "minimum": 2000},
        "through_week": {"type": "integer", "minimum": 1},
        "weeks": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "horizon": {"type": "string", "minLength": 1},
        "scoring_presets": {"type": "array", "items": {"enum": ["STD", "HALF", "PPR"]}},
        "definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appearance", "points", "points_per_game", "season_rank", "comparison",
            "model_difference"
          ],
          "properties": {
            "appearance": {"type": "string", "minLength": 1},
            "points": {"type": "string", "minLength": 1},
            "points_per_game": {"type": "string", "minLength": 1},
            "season_rank": {"type": "string", "minLength": 1},
            "comparison": {"type": "string", "minLength": 1},
            "model_difference": {"type": "string", "minLength": 1}
          }
        },
        "records": {"type": "integer", "minimum": 0},
        "population": {
          "type": "object",
          "description": "Players ranked at each position: everyone who has appeared, whichever board publishes him. The denominator of a season rank.",
          "additionalProperties": false,
          "required": ["QB", "RB", "WR", "TE"],
          "properties": {
            "QB": {"type": "integer", "minimum": 0},
            "RB": {"type": "integer", "minimum": 0},
            "WR": {"type": "integer", "minimum": 0},
            "TE": {"type": "integer", "minimum": 0}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weeks_checked", "scheduled_team_weeks", "weekly_stats_missing_team_weeks",
            "snap_counts_missing_team_weeks", "snap_only_appearances", "unbridged_snap_rows"
          ],
          "properties": {
            "weeks_checked": {"type": "integer", "minimum": 0},
            "scheduled_team_weeks": {"type": "integer", "minimum": 0},
            "weekly_stats_missing_team_weeks": {"type": "integer", "minimum": 0},
            "snap_counts_missing_team_weeks": {"type": "integer", "minimum": 0},
            "snap_only_appearances": {
              "type": "integer",
              "minimum": 0,
              "description": "Weeks counted as games from snaps alone (no statistic): the whole difference between this games count and the model's own."
            },
            "unbridged_snap_rows": {
              "type": "integer",
              "minimum": 0,
              "description": "Core-position snap rows with no canonical id. Excluded (fail closed) and counted."
            }
          }
        }
      }
    },
    "disclosures": {
      "type": "object",
      "description": "ADR-076's disclosure contract, carried on the artifact so the frontend cannot publish the flag without the sentences that make it honest.",
      "additionalProperties": true,
      "required": [
        "uses_injury_information", "long_absence_definition", "long_absence_statement",
        "long_absence_ordering_weakness", "status_is_annotation_only", "long_absence_players"
      ],
      "properties": {
        "uses_injury_information": {
          "const": false,
          "description": "The rest-of-season model has no injury or practice-report feature of any kind (ADR-070). This is a constant because it is a property of the model, not a build-time observation."
        },
        "long_absence_definition": {"type": "string", "minLength": 1},
        "long_absence_statement": {"type": "string", "minLength": 1},
        "long_absence_ordering_weakness": {"type": "string", "minLength": 1},
        "status_is_annotation_only": {"const": true},
        "long_absence_players": {"type": "integer", "minimum": 0},
        "tier_boundary_statement": {"type": "string"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "The measured limitations the accepted model carries into production (ADR-077). Published, not repaired."
    },
    "supported_presets": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status", "retrieved_at_utc", "record_count"],
        "properties": {
          "source_id": {"type": "string"},
          "status": {"enum": ["pass", "warning", "failed", "disabled"]},
          "retrieved_at_utc": {"type": "string", "format": "date-time"},
          "source_as_of_utc": {"type": ["string", "null"], "format": "date-time"},
          "record_count": {"type": "integer", "minimum": 0},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "critical_failures", "warnings"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "critical_failures": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
