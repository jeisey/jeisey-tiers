{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ros_build_metadata.schema.json",
  "title": "RosBuildMetadata",
  "description": "Build-level provenance for the in-season bundle. Separate from build_metadata.json on purpose: the draft board and the rest-of-season board are produced by different models on different cadences from different cutoffs, so they carry different build ids and are validated independently (roadmap 12.5). A directory may hold either bundle, both, or one refreshed while the other is not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "build_id", "generated_at_utc", "git_sha", "season",
    "through_week", "season_state", "ros_model_version", "cutoff_rule_version",
    "methodology_version", "simulation", "source_freshness", "disclosures",
    "limitations", "supported_presets", "sources", "quality_gate", "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "build_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "git_sha": {"type": "string", "minLength": 7},
    "season": {"type": "integer", "minimum": 2000},
    "through_week": {
      "type": "integer",
      "minimum": 1,
      "description": "The point-in-time cutoff every number in this bundle was computed at."
    },
    "season_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rule_version", "season_state", "product_mode", "completed_week"],
      "properties": {
        "rule_version": {"type": "string", "minLength": 1},
        "season_state": {
          "enum": ["preseason_draft", "regular_season", "fantasy_postseason", "season_complete"]
        },
        "product_mode": {"enum": ["draft", "in_season"]},
        "completed_week": {"type": "integer", "minimum": 0},
        "latest_snapshot_week": {"type": ["integer", "null"], "minimum": 1},
        "next_transition_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "ros_model_version": {"type": "string", "minLength": 1},
    "ros_model_configuration_hash": {
      "type": ["string", "null"],
      "description": "Digest of the frozen architecture the fit used (ADR-078). Two fits of the accepted model on different training windows agree here; a tuned parameter does not."
    },
    "production_fit_rule_version": {"type": ["string", "null"]},
    "model_fitted_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "model_training_seasons": {"type": "array", "items": {"type": "integer"}},
    "model_refit_reason": {"type": ["string", "null"]},
    "cutoff_rule_version": {"type": "string", "minLength": 1},
    "feature_set_version": {"type": ["string", "null"]},
    "feature_set_hash": {"type": ["string", "null"]},
    "methodology_version": {"type": "string", "minLength": 1},
    "simulation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["draws", "seed", "replacement_rule", "convergence_gate", "tier_stability_gate"],
      "properties": {
        "draws": {"type": "integer", "minimum": 1},
        "draws_status": {"type": "string"},
        "seed": {"type": "integer"},
        "ranking_statistic": {"type": "string"},
        "replacement_rule": {"enum": ["fresh_allocation", "rostered_depth"]},
        "replacement_rule_description": {"type": "string"},
        "tier_algorithm": {"type": "string"},
        "tier_penalty": {"type": "number"},
        "tier_depth": {"type": "integer", "minimum": 1},
        "value_version": {"type": "string"},
        "convergence_gate": {"enum": ["pass", "fail"]},
        "tier_stability_gate": {"enum": ["pass", "fail"]}
      }
    },
    "source_freshness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rule_version", "available_through_week", "schedule_completed_week"],
      "properties": {
        "rule_version": {"type": "string"},
        "available_through_week": {"type": "integer", "minimum": 0},
        "schedule_completed_week": {"type": "integer", "minimum": 0},
        "blocking_week": {"type": ["integer", "null"]},
        "buildable": {"type": "boolean"}
      }
    },
    "behavior": {
      "type": ["object", "null"],
      "description": "The optional in-season behaviour feed powering the Opportunity Board. Null or unavailable degrades that board's behaviour columns and nothing else.",
      "additionalProperties": true,
      "properties": {
        "source_id": {"type": ["string", "null"]},
        "available": {"type": "boolean"},
        "snapshot_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "lookback_hours": {"type": ["integer", "null"]},
        "request_limit": {"type": ["integer", "null"]},
        "add_rows": {"type": ["integer", "null"], "minimum": 0},
        "drop_rows": {"type": ["integer", "null"], "minimum": 0},
        "matched_players": {"type": ["integer", "null"], "minimum": 0},
        "age_hours": {"type": ["number", "null"], "minimum": 0},
        "degraded_reason": {"type": ["string", "null"]},
        "signal_semantics": {"type": "string"},
        "history": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "The retained window behind `behavior_trend_series.json` (ADR-089). Null when no retained observation falls inside the trend window, which withholds the momentum sparkline and nothing else. `snapshot_at_utc` above is the single instant the board's own counts came from; this describes every instant the series draws.",
          "properties": {
            "rule_version": {"type": "string", "description": "`behavior_trend_v1`."},
            "window_days": {"type": "number", "exclusiveMinimum": 0},
            "min_observations": {
              "type": "integer",
              "minimum": 2,
              "description": "Observations required before a direction is stated. Two: a line needs two points, and an add count moves far too fast for the market rule's three-day bar."
            },
            "snapshots_in_window": {"type": "integer", "minimum": 0},
            "snapshot_keys": {"type": "array", "items": {"type": "string"}},
            "anchored_at_utc": {"type": ["string", "null"], "format": "date-time"},
            "observations": {"type": "integer", "minimum": 0},
            "players": {"type": "integer", "minimum": 0},
            "players_with_trend": {"type": "integer", "minimum": 0},
            "players_with_sparse_coverage": {
              "type": "integer",
              "minimum": 0,
              "description": "Players the window held snapshots for that did not carry them — days they were outside the feed's top N, which is an unknown count rather than a zero."
            },
            "trend_available": {"type": "boolean"},
            "unresolved_rows": {"type": "integer", "minimum": 0},
            "lookback_hours": {"type": ["integer", "null"]},
            "request_limit": {"type": ["integer", "null"]},
            "source_id": {"type": ["string", "null"]}
          }
        }
      }
    },
    "surface": {
      "type": ["object", "null"],
      "description": "The public surface universe for the in-season board (ADR-063): who is visible and why.",
      "additionalProperties": true
    },
    "signals": {
      "type": ["object", "null"],
      "description": "The in-season signal layer (ADR-091): which rules produced player_usage.json and team_matchups.json, how many records each carries, and the two sentences that must travel with them. Optional and additive: absent or null removes the evidence blocks those artifacts feed and nothing else.",
      "additionalProperties": false,
      "required": [
        "usage_rule", "usage_records", "matchup_rule_version", "matchup_records",
        "lines_source_id", "lines_retrieved_at_utc", "lines_posted_teams",
        "sportsbook_context_statement", "expected_points_statement"
      ],
      "properties": {
        "usage_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version", "change_rule_version", "min_earlier_games",
            "min_touchdown_share_points", "min_epa_dropbacks"
          ],
          "properties": {
            "version": {"const": "usage_signals_v1"},
            "change_rule_version": {"const": "role_change_v1"},
            "min_earlier_games": {"type": "integer", "minimum": 1},
            "min_touchdown_share_points": {"type": "number", "minimum": 0},
            "min_epa_dropbacks": {"type": "number", "minimum": 0}
          }
        },
        "usage_records": {"type": "integer", "minimum": 0},
        "matchup_rule_version": {"const": "next_game_v1"},
        "matchup_records": {"type": "integer", "minimum": 0},
        "lines_source_id": {"type": ["string", "null"]},
        "lines_retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "lines_posted_teams": {
          "type": "integer",
          "minimum": 0,
          "description": "Teams whose next game carries a posted spread and total."
        },
        "sportsbook_context_statement": {
          "type": "string",
          "minLength": 1,
          "description": "Printed wherever a line is shown: which models read the lines (since ADR-096, the weekly start/sit projection only) and which never do (every draft and rest-of-season number)."
        },
        "expected_points_statement": {
          "type": "string",
          "minLength": 1,
          "description": "Why no expected-points reading is published (the open CC-BY-SA decision, ADR-086)."
        },
        "drive_breadth": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "required": ["method_version", "status", "statement"],
          "description": "ADR-103/ADR-104: whether the drive-breadth blocks on player_usage were published, the window and provisional display minimums, each position's displayed quartiles on this build (no longer printed on the card), and the statement the Data view prints. Optional and additive.",
          "properties": {
            "method_version": {"const": "drive_breadth_v2"},
            "status": {"enum": ["published", "unavailable"]},
            "statement": {"type": "string", "minLength": 1},
            "position_reference": {"type": ["object", "null"]}
          }
        }
      }
    },
    "weekly": {
      "type": ["object", "null"],
      "description": "The weekly start/sit layer (ADR-096): which model produced weekly_projections.json, for which week, how a page turns seven quantiles into a distribution, and the measured numbers the Start/Sit tab prints beside it — matchup-margin uncertainty, same-game correlation, league startable thresholds, injury-designation appearance rates and the sealed-season evaluation. Optional and additive: absent or null removes the Start/Sit tab's content and nothing else.",
      "additionalProperties": false,
      "required": [
        "model_version", "candidate_version", "configuration_hash", "training_seasons",
        "fitted_at_utc", "through_week", "target_week", "records", "upcoming", "kicked_off",
        "bye", "lines_pending", "quantile_levels", "distribution_rule", "families", "margin", "correlation",
        "startable", "injury_base_rates", "evaluation", "injuries_retrieved_at_utc", "statement"
      ],
      "properties": {
        "model_version": {"const": "weekly-startsit-v1"},
        "candidate_version": {"type": "string", "minLength": 1},
        "configuration_hash": {"type": "string", "minLength": 8},
        "training_seasons": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
        "fitted_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "through_week": {"type": "integer", "minimum": 1},
        "target_week": {"type": "integer", "minimum": 2},
        "records": {"type": "integer", "minimum": 0},
        "upcoming": {"type": "integer", "minimum": 0},
        "kicked_off": {"type": "integer", "minimum": 0},
        "bye": {"type": "integer", "minimum": 0},
        "lines_pending": {"type": "integer", "minimum": 0, "description": "Players whose game has no posted total or spread yet: published without a distribution."},
        "quantile_levels": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "minItems": 3},
        "distribution_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "tail_lower_factor", "tail_upper_factor", "grid_points"],
          "properties": {
            "version": {"const": "quantile_distribution_v1"},
            "tail_lower_factor": {"type": "number", "minimum": 0},
            "tail_upper_factor": {"type": "number", "minimum": 0},
            "grid_points": {"type": "integer", "minimum": 10}
          }
        },
        "families": {"type": "object", "additionalProperties": {"type": "string"}},
        "margin": {"type": "object", "description": "Per scoring preset: residual variance by position among starters, the lineup total, and margin_sd_by_slot — the standard deviation of a matchup's margin from every other slot. Out-of-fold."},
        "correlation": {"type": "object", "description": "Same-game Gaussian-copula correlations, teammates by position pair and opponents, from out-of-fold PIT values."},
        "startable": {"type": "object", "description": "Per league preset and scoring preset: the average points of the last starter at each position."},
        "injury_base_rates": {"type": "object", "description": "Per official designation: reports, appearances and the appearance rate over the training seasons."},
        "evaluation": {"type": "object", "description": "The sealed-season (2025) result the page quotes, including the start/sit calibration table."},
        "injuries_retrieved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "statement": {"type": "string", "minLength": 40},
        "explanation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["rule", "levels", "groups", "reference_shrink_games", "reference", "statement"],
          "description": "How every weekly record's `explanation` was made (ADR-099): the typical-week reference, the explained levels, the input groups and their labels, and the sentence that keeps an attribution from reading as a causal effect.",
          "properties": {
            "rule": {"const": "typical_week_shapley_v1"},
            "levels": {"type": "array", "items": {"enum": ["q10", "q50", "q90"]}, "minItems": 1},
            "groups": {"type": "object", "additionalProperties": {"type": "string"}},
            "reference_shrink_games": {"type": "number", "minimum": 0},
            "reference": {"type": "string", "minLength": 40},
            "statement": {"type": "string", "minLength": 40}
          }
        },
        "context": {
          "type": ["object", "null"],
          "description": "What weekly_context.json was built from (ADR-099): forecast capture key and time, weather statuses by count, report rows and teams whose report carries game statuses, listed players, unresolved venues. Null when the context was withheld."
        },
        "shadow": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["model_version", "status", "rows"],
          "description": "The private weekly-startsit-v2 shadow record's summary (ADR-099): whether a shadow candidate ran beside v1 and how many pregame rows it retained. The rows themselves are never published.",
          "properties": {
            "model_version": {"const": "weekly-startsit-v2"},
            "status": {"enum": ["absent", "shadow", "failed"]},
            "rows": {"type": "integer", "minimum": 0},
            "pregame": {"type": "integer", "minimum": 0},
            "with_v2": {"type": "integer", "minimum": 0},
            "configuration_hash": {"type": ["string", "null"]}
          }
        }
      }
    },
    "season_actuals": {
      "type": ["object", "null"],
      "description": "ADR-105: how season_actuals.json was built — the rule, the cutoff and the weeks it covers, the sentences every surface prints beside the numbers, the population ranked at each position, and the source coverage that decided whether it was published. `withheld` means a scheduled team-week was missing upstream and no actuals were published, so every surface prints them as unavailable rather than as ranks over a smaller population. Optional and additive: absent or null is the same unavailable state.",
      "additionalProperties": false,
      "required": [
        "rule", "status", "withheld_reason", "season", "through_week", "weeks", "horizon",
        "scoring_presets", "definitions", "records", "population", "coverage"
      ],
      "properties": {
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "points_decimals", "rank_method", "scoring_engine_version"],
          "properties": {
            "version": {"const": "season_actuals_v1"},
            "points_decimals": {"type": "integer", "minimum": 0},
            "rank_method": {"const": "competition"},
            "scoring_engine_version": {"type": "string", "minLength": 1}
          }
        },
        "status": {"enum": ["published", "withheld"]},
        "withheld_reason": {"type": ["string", "null"]},
        "season": {"type": "integer", "minimum": 2000},
        "through_week": {"type": "integer", "minimum": 1},
        "weeks": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "horizon": {"type": "string", "minLength": 1},
        "scoring_presets": {"type": "array", "items": {"enum": ["STD", "HALF", "PPR"]}},
        "definitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appearance", "points", "points_per_game", "season_rank", "comparison",
            "model_difference"
          ],
          "properties": {
            "appearance": {"type": "string", "minLength": 1},
            "points": {"type": "string", "minLength": 1},
            "points_per_game": {"type": "string", "minLength": 1},
            "season_rank": {"type": "string", "minLength": 1},
            "comparison": {"type": "string", "minLength": 1},
            "model_difference": {"type": "string", "minLength": 1}
          }
        },
        "records": {"type": "integer", "minimum": 0},
        "population": {
          "type": "object",
          "description": "Players ranked at each position: everyone who has appeared, whichever board publishes him. The denominator of a season rank.",
          "additionalProperties": false,
          "required": ["QB", "RB", "WR", "TE"],
          "properties": {
            "QB": {"type": "integer", "minimum": 0},
            "RB": {"type": "integer", "minimum": 0},
            "WR": {"type": "integer", "minimum": 0},
            "TE": {"type": "integer", "minimum": 0}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weeks_checked", "scheduled_team_weeks", "weekly_stats_missing_team_weeks",
            "snap_counts_missing_team_weeks", "snap_only_appearances", "unbridged_snap_rows"
          ],
          "properties": {
            "weeks_checked": {"type": "integer", "minimum": 0},
            "scheduled_team_weeks": {"type": "integer", "minimum": 0},
            "weekly_stats_missing_team_weeks": {"type": "integer", "minimum": 0},
            "snap_counts_missing_team_weeks": {"type": "integer", "minimum": 0},
            "snap_only_appearances": {
              "type": "integer",
              "minimum": 0,
              "description": "Weeks counted as games from snaps alone (no statistic): the whole difference between this games count and the model's own."
            },
            "unbridged_snap_rows": {
              "type": "integer",
              "minimum": 0,
              "description": "Core-position snap rows with no canonical id. Excluded (fail closed) and counted."
            }
          }
        }
      }
    },
    "disclosures": {
      "type": "object",
      "description": "ADR-076's disclosure contract, carried on the artifact so the frontend cannot publish the flag without the sentences that make it honest.",
      "additionalProperties": true,
      "required": [
        "uses_injury_information", "long_absence_definition", "long_absence_statement",
        "long_absence_ordering_weakness", "status_is_annotation_only", "long_absence_players"
      ],
      "properties": {
        "uses_injury_information": {
          "const": false,
          "description": "The rest-of-season model has no injury or practice-report feature of any kind (ADR-070). This is a constant because it is a property of the model, not a build-time observation."
        },
        "long_absence_definition": {"type": "string", "minLength": 1},
        "long_absence_statement": {"type": "string", "minLength": 1},
        "long_absence_ordering_weakness": {"type": "string", "minLength": 1},
        "status_is_annotation_only": {"const": true},
        "long_absence_players": {"type": "integer", "minimum": 0},
        "tier_boundary_statement": {"type": "string"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "The measured limitations the accepted model carries into production (ADR-077). Published, not repaired."
    },
    "supported_presets": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status", "retrieved_at_utc", "record_count"],
        "properties": {
          "source_id": {"type": "string"},
          "status": {"enum": ["pass", "warning", "failed", "disabled"]},
          "retrieved_at_utc": {"type": "string", "format": "date-time"},
          "source_as_of_utc": {"type": ["string", "null"], "format": "date-time"},
          "record_count": {"type": "integer", "minimum": 0},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "critical_failures", "warnings"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "critical_failures": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
