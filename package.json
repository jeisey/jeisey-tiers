{
  "name": "jeisey-tiers-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fantasy Draft Intelligence frontend: static tier and arbitrage boards built from versioned public artifacts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --build --force && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:build": "node --experimental-strip-types web/tests/e2e/build-fixtures.ts",
    "e2e:screens": "node web/tests/e2e/capture-screens.mjs",
    "verify:board": "node web/tests/e2e/verify-real-build.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
